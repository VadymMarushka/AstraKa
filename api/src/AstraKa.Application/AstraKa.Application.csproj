<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Application: use cases (MediatR commands/queries), validators, DTOs and the
    interfaces the outer layers implement (IAppDbContext, ICurrentUser,
    IHoroscopeProvider, ADO.NET repositories). Depends on Domain only.
  -->
  <PropertyGroup>
    <!-- Lets DTO/record XML doc comments flow into the API's generated OpenAPI document (lab 3) -
         CS1591 is suppressed since this project isn't meant to doc-comment every public member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AstraKa.Domain\AstraKa.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <PackageReference Include="MediatR" Version="14.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />
  </ItemGroup>

  <!-- Lets QueryTranslationTests call handlers' internal static query-building methods directly,
       so it captures their real LINQ shape instead of a re-implemented stand-in. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>AstraKa.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
