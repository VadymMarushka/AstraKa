  <ItemGroup>
    <ProjectReference Include="..\AstraKa.Application\AstraKa.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
