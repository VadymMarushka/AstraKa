<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure: EF Core DbContext and entity configurations, migrations,
    seeding, ADO.NET repositories, external HTTP clients. Implements the
    Application interfaces, so it depends on Application (and Domain through it).
  -->
  <PropertyGroup>
    <!-- Lets any XML doc comments here flow into the API's generated OpenAPI document (lab 3) -
         CS1591 is suppressed since this project isn't meant to doc-comment every public member. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AstraKa.Application\AstraKa.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

</Project>
